<UserControl x:Class="PdfAcrobat.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PdfAcrobat.App.ViewModels"
             xmlns:viewer="clr-namespace:PdfAcrobat.App.Controls.Viewer"
             x:Name="Root"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="PanelCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" IsChecked="{Binding IsToolsPaneOpen}" ToolTip="すべてのツール (Shift+F4)">
                        <ui:SymbolIcon Symbol="PanelLeft24" />
                    </ToggleButton>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding SaveAsCommand}" ToolTip="名前を付けて保存 (Ctrl+Shift+S)">
                        <ui:SymbolIcon Symbol="Save24" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding PrintCommand}" ToolTip="印刷 (Ctrl+P)">
                        <ui:SymbolIcon Symbol="Print24" />
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button Style="{StaticResource ToolButtonStyle}" IsEnabled="False" ToolTip="元に戻す (Ctrl+Z) — Phase 2 で対応">
                        <ui:SymbolIcon Symbol="ArrowUndo24" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" IsEnabled="False" ToolTip="やり直し (Ctrl+Y) — Phase 2 で対応">
                        <ui:SymbolIcon Symbol="ArrowRedo24" />
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                    <RadioButton Style="{StaticResource ToolRadioButtonStyle}" GroupName="Tool" IsChecked="{Binding IsSelectTool}" ToolTip="テキスト選択ツール">
                        <ui:SymbolIcon Symbol="Cursor24" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolRadioButtonStyle}" GroupName="Tool" IsChecked="{Binding IsHandTool}" ToolTip="手のひらツール (Space キーを押している間も有効)">
                        <ui:SymbolIcon Symbol="HandLeft24" />
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding OpenFindBarCommand}" ToolTip="文書内を検索 (Ctrl+F)">
                        <ui:SymbolIcon Symbol="Search24" />
                    </Button>
                    <Button x:Name="LayoutButton" Style="{StaticResource ToolButtonStyle}" Click="OnMenuButtonClick" ToolTip="ページ表示">
                        <ui:SymbolIcon Symbol="BookOpen24" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="単一ページ表示" IsCheckable="True" IsChecked="{Binding IsSinglePage, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static viewer:PageLayoutMode.SinglePage}" />
                                <MenuItem Header="スクロールを有効にする" IsCheckable="True" IsChecked="{Binding IsContinuous, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static viewer:PageLayoutMode.Continuous}" />
                                <MenuItem Header="見開きページ表示" IsCheckable="True" IsChecked="{Binding IsTwoPage, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static viewer:PageLayoutMode.TwoPage}" />
                                <MenuItem Header="見開きページでスクロール" IsCheckable="True" IsChecked="{Binding IsTwoPageContinuous, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static viewer:PageLayoutMode.TwoPageContinuous}" />
                                <Separator />
                                <MenuItem Header="見開きページ表示で表紙を表示" IsCheckable="True" IsChecked="{Binding CoverPage, Mode=OneWay}" Command="{Binding ToggleCoverPageCommand}" />
                                <Separator />
                                <MenuItem Header="表示を右に回転" InputGestureText="Ctrl+Shift+テンキー+" Command="{Binding RotateViewClockwiseCommand}" />
                                <MenuItem Header="表示を左に回転" InputGestureText="Ctrl+Shift+テンキー-" Command="{Binding RotateViewCounterClockwiseCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding RotateViewClockwiseCommand}" ToolTip="表示を右に回転 (保存されません)">
                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding FullScreenCommand}" ToolTip="フルスクリーンモード (Ctrl+L)">
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ShowPropertiesCommand}" ToolTip="文書のプロパティ (Ctrl+D)">
                        <ui:SymbolIcon Symbol="Info24" />
                    </Button>
                </StackPanel>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- All tools pane -->
            <Border Grid.Column="0"
                    Width="236"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsToolsPaneOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="16,14,16,8" Style="{StaticResource PanelHeaderTextStyle}" Text="すべてのツール" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="6,0,6,8" ItemsSource="{x:Static vm:ToolCatalog.All}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ToolsPaneButtonStyle}"
                                            Click="OnToolClick"
                                            ToolTip="{Binding Description}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{Binding Accent}">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" />
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Text="{Binding StatusText}"
                                                           Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Viewer with floating bars -->
            <Grid Grid.Column="1">
                <viewer:PdfViewer x:Name="Viewer"
                                  Session="{Binding Session}"
                                  Zoom="{Binding Zoom}"
                                  ZoomMode="{Binding ZoomMode}"
                                  LayoutMode="{Binding LayoutMode}"
                                  CoverPage="{Binding CoverPage}"
                                  ViewRotation="{Binding ViewRotation}"
                                  CurrentPageIndex="{Binding CurrentPageIndex}"
                                  Tool="{Binding Tool}"
                                  SearchHits="{Binding SearchHits}"
                                  CurrentSearchHit="{Binding CurrentSearchHit}" />

                <!-- Find bar -->
                <Border Style="{StaticResource FloatingBarStyle}"
                        Margin="0,10,26,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsFindBarOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="FindBox"
                                        Width="230"
                                        Margin="2"
                                        PlaceholderText="文書内を検索"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewKeyDown="OnFindBoxKeyDown" />
                            <TextBlock MinWidth="64"
                                       Margin="8,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{Binding SearchStatus}" />
                            <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding FindPreviousCommand}" ToolTip="前を検索 (Shift+Enter)">
                                <ui:SymbolIcon Symbol="ChevronUp24" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding FindNextCommand}" ToolTip="次を検索 (Enter)">
                                <ui:SymbolIcon Symbol="ChevronDown24" />
                            </Button>
                            <ToggleButton x:Name="FindOptionsToggle" Style="{StaticResource ToolToggleButtonStyle}" ToolTip="検索オプション">
                                <ui:SymbolIcon Symbol="Options24" />
                            </ToggleButton>
                            <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding CloseFindBarCommand}" ToolTip="閉じる (Esc)">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="8,4,8,6" Visibility="{Binding IsChecked, ElementName=FindOptionsToggle, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="大文字と小文字を区別する" IsChecked="{Binding MatchCase}" />
                            <CheckBox Content="単語単位で検索する" IsChecked="{Binding WholeWord}" />
                            <CheckBox Content="全角と半角を区別する" IsChecked="{Binding MatchWidth}" />
                            <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="結果を一覧表示" Click="OnShowSearchResultsClick" />
                        </StackPanel>
                        <ProgressBar Height="2"
                                     Margin="4,0,4,0"
                                     Maximum="1"
                                     Value="{Binding SearchProgress}"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Page navigation and zoom -->
                <Border Style="{StaticResource FloatingBarStyle}"
                        Margin="0,0,26,20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding PreviousPageCommand}" ToolTip="前のページ">
                            <ui:SymbolIcon Symbol="ChevronUp24" />
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding NextPageCommand}" ToolTip="次のページ">
                            <ui:SymbolIcon Symbol="ChevronDown24" />
                        </Button>
                        <TextBox x:Name="PageBox"
                                 Width="52"
                                 Margin="4,2"
                                 Padding="4,3"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 MinHeight="28"
                                 Text="{Binding CurrentPageNumber, Mode=OneWay}"
                                 ToolTip="{Binding CurrentPageLabel}"
                                 PreviewKeyDown="OnPageBoxKeyDown"
                                 LostKeyboardFocus="OnPageBoxLostFocus"
                                 GotKeyboardFocus="OnPageBoxGotFocus" />
                        <TextBlock Margin="2,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}">
                            <Run Text="/" />
                            <Run Text="{Binding PageCount, Mode=OneWay}" />
                        </TextBlock>
                        <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="2,0" />
                        <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="縮小 (Ctrl+-)">
                            <ui:SymbolIcon Symbol="ZoomOut24" />
                        </Button>
                        <Button x:Name="ZoomButton"
                                MinWidth="58"
                                Style="{StaticResource TextToolButtonStyle}"
                                Click="OnMenuButtonClick"
                                ToolTip="ズーム"
                                Content="{Binding ZoomText}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="ページレベルにズーム" InputGestureText="Ctrl+0" IsCheckable="True" IsChecked="{Binding IsFitPage, Mode=OneWay}" Command="{Binding FitPageCommand}" />
                                    <MenuItem Header="幅に合わせる" InputGestureText="Ctrl+2" IsCheckable="True" IsChecked="{Binding IsFitWidth, Mode=OneWay}" Command="{Binding FitWidthCommand}" />
                                    <MenuItem Header="実際のサイズ" InputGestureText="Ctrl+1" Command="{Binding ActualSizeCommand}" />
                                    <Separator />
                                    <MenuItem Header="25%" Command="{Binding SetZoomPercentCommand}" CommandParameter="25" />
                                    <MenuItem Header="50%" Command="{Binding SetZoomPercentCommand}" CommandParameter="50" />
                                    <MenuItem Header="75%" Command="{Binding SetZoomPercentCommand}" CommandParameter="75" />
                                    <MenuItem Header="100%" Command="{Binding SetZoomPercentCommand}" CommandParameter="100" />
                                    <MenuItem Header="125%" Command="{Binding SetZoomPercentCommand}" CommandParameter="125" />
                                    <MenuItem Header="150%" Command="{Binding SetZoomPercentCommand}" CommandParameter="150" />
                                    <MenuItem Header="200%" Command="{Binding SetZoomPercentCommand}" CommandParameter="200" />
                                    <MenuItem Header="400%" Command="{Binding SetZoomPercentCommand}" CommandParameter="400" />
                                    <MenuItem Header="800%" Command="{Binding SetZoomPercentCommand}" CommandParameter="800" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="拡大 (Ctrl++)">
                            <ui:SymbolIcon Symbol="ZoomIn24" />
                        </Button>
                        <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" IsChecked="{Binding IsFitPage, Mode=OneWay}" Command="{Binding FitPageCommand}" ToolTip="ページ全体を表示 (Ctrl+0)">
                            <ui:SymbolIcon Symbol="PageFit24" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" IsChecked="{Binding IsFitWidth, Mode=OneWay}" Command="{Binding FitWidthCommand}" ToolTip="幅に合わせる (Ctrl+2)">
                            <ui:SymbolIcon Symbol="ArrowAutofitWidth24" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Side panel content -->
            <Border Grid.Column="2"
                    Width="252"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <!-- Thumbnails -->
                    <DockPanel Visibility="{Binding IsThumbnailsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButtonStyle}" Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Thumbnails}" ToolTip="閉じる">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                            <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="ページサムネール" />
                        </DockPanel>
                        <ListBox x:Name="ThumbnailList"
                                 ItemsSource="{Binding Thumbnails}"
                                 ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Standard"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,4"
                                                HorizontalAlignment="Center"
                                                Background="Transparent"
                                                Loaded="OnThumbnailLoaded"
                                                MouseLeftButtonUp="OnThumbnailClick"
                                                Cursor="Hand">
                                        <Border x:Name="Frame"
                                                Padding="3"
                                                CornerRadius="4"
                                                BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <Border Width="{x:Static vm:ThumbnailItemViewModel.ThumbnailWidth}"
                                                    Height="{Binding ThumbnailHeight}"
                                                    Background="White"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                                    BorderThickness="1">
                                                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </Border>
                                        <TextBlock x:Name="Label"
                                                   Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Label}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ThumbnailSelectedBorderBrush}" />
                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Bookmarks -->
                    <DockPanel Visibility="{Binding IsBookmarksPanelOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButtonStyle}" Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Bookmarks}" ToolTip="閉じる">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                            <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="しおり" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Margin="16,8"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="この文書にはしおりがありません。"
                                       Visibility="{Binding HasBookmarks, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TreeView x:Name="BookmarkTree"
                                      ItemsSource="{Binding Bookmarks}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectedItemChanged="OnBookmarkSelected">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnBookmarkClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </DockPanel>

                    <!-- Search results -->
                    <DockPanel Visibility="{Binding IsSearchPanelOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButtonStyle}" Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.SearchResults}" ToolTip="閉じる">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                            <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="検索結果" />
                        </DockPanel>
                        <ui:TextBox DockPanel.Dock="Top"
                                    Margin="10,0,10,6"
                                    PlaceholderText="文書内を検索"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewKeyDown="OnFindBoxKeyDown" />
                        <TextBlock DockPanel.Dock="Top" Margin="14,0,14,6" Style="{StaticResource MutedTextStyle}" Text="{Binding SearchStatus}" />
                        <ListBox x:Name="SearchResultList"
                                 ItemsSource="{Binding SearchResults}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSearchResultSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}">
                                            <Run Text="ページ" />
                                            <Run Text="{Binding PageIndex, Mode=OneWay, Converter={StaticResource PageNumber}}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Text="{Binding Context}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Panel icon strip -->
            <Border Grid.Column="3"
                    Width="46"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1,0,0,0">
                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                    <ToggleButton Margin="0,2" Style="{StaticResource ToolToggleButtonStyle}" IsChecked="{Binding IsThumbnailsPanelOpen}" ToolTip="ページサムネール (F4)">
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ToggleButton>
                    <ToggleButton Margin="0,2" Style="{StaticResource ToolToggleButtonStyle}" IsChecked="{Binding IsBookmarksPanelOpen}" ToolTip="しおり">
                        <ui:SymbolIcon Symbol="BookmarkMultiple24" />
                    </ToggleButton>
                    <ToggleButton Margin="0,2" Style="{StaticResource ToolToggleButtonStyle}" IsChecked="{Binding IsSearchPanelOpen}" ToolTip="検索結果">
                        <ui:SymbolIcon Symbol="DocumentSearch24" />
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
