<ui:FluentWindow x:Class="PdfAcrobat.App.Views.Dialogs.DocumentPropertiesDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="文書のプロパティ"
                 Width="560"
                 Height="600"
                 MinWidth="420"
                 MinHeight="360"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding Value, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         MinHeight="0"
                         FontSize="12.5"
                         TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="文書のプロパティ" ShowMinimize="False" />
        <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,16" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Width="96" Appearance="Primary" Content="OK" IsDefault="True" IsCancel="True" />
        </StackPanel>
        <TabControl Margin="16,0,16,0">
            <TabItem Header="概要">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12">
                        <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="文書" Margin="0,0,0,6" />
                        <ItemsControl x:Name="DocumentRows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                        <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="ファイル" Margin="0,14,0,6" />
                        <ItemsControl x:Name="FileRows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="セキュリティ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12">
                        <ItemsControl x:Name="SecurityRows" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:FluentWindow>
