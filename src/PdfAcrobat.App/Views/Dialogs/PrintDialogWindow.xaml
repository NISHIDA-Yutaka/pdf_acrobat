<ui:FluentWindow x:Class="PdfAcrobat.App.Views.Dialogs.PrintDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="印刷"
                 Width="760"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderTextStyle}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <ui:TitleBar Title="印刷" ShowMaximize="False" ShowMinimize="False" />
        <Grid Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="SettingsPanel">
                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,6" Text="プリンター" />
                <ComboBox x:Name="PrinterBox" SelectionChanged="OnSettingChanged" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="部数:" Margin="0,0,10,0" />
                    <TextBox x:Name="CopiesBox" Grid.Column="1" Text="1" HorizontalContentAlignment="Right" />
                    <CheckBox x:Name="CollateBox" Grid.Column="2" Margin="14,0,0,0" Content="部単位で印刷" IsChecked="True" />
                </Grid>

                <TextBlock Style="{StaticResource SectionHeader}" Text="印刷するページ" />
                <RadioButton x:Name="AllPagesRadio" GroupName="Range" Content="すべて" IsChecked="True" Checked="OnSettingChanged" />
                <RadioButton x:Name="CurrentPageRadio" GroupName="Range" Content="現在のページ" Checked="OnSettingChanged" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RangeRadio" GroupName="Range" Content="ページ指定" Checked="OnSettingChanged" />
                    <TextBox x:Name="RangeBox" Grid.Column="1" Margin="8,0,0,0" Text="1" GotKeyboardFocus="OnRangeBoxFocus" TextChanged="OnSettingChanged" />
                </Grid>
                <TextBlock x:Name="RangeHint" Margin="28,2,0,0" FontSize="11" Style="{StaticResource MutedTextStyle}" Text="例: 1-3, 5, 8-" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="ページサイズ処理" />
                <WrapPanel>
                    <RadioButton x:Name="FitRadio" GroupName="Scale" Content="合わせる" IsChecked="True" Checked="OnSettingChanged" Margin="0,0,12,0" />
                    <RadioButton x:Name="ActualRadio" GroupName="Scale" Content="実際のサイズ" Checked="OnSettingChanged" Margin="0,0,12,0" />
                    <RadioButton x:Name="ShrinkRadio" GroupName="Scale" Content="大きいページを縮小" Checked="OnSettingChanged" />
                </WrapPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="向き" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AutoOrientationRadio" GroupName="Orientation" Content="縦/横 自動" IsChecked="True" Checked="OnSettingChanged" Margin="0,0,12,0" />
                    <RadioButton x:Name="PortraitRadio" GroupName="Orientation" Content="縦" Checked="OnSettingChanged" Margin="0,0,12,0" />
                    <RadioButton x:Name="LandscapeRadio" GroupName="Orientation" Content="横" Checked="OnSettingChanged" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="オプション" />
                <CheckBox x:Name="AnnotationsBox" Content="注釈とフォームを印刷" IsChecked="True" />
                <CheckBox x:Name="GrayscaleBox" Content="グレースケール（白黒）で印刷" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
            </StackPanel>

            <!-- Preview -->
            <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" HorizontalAlignment="Center" Text="プレビュー" />
                <Border Width="300" Height="380" Background="{DynamicResource CanvasBackgroundBrush}" CornerRadius="6">
                    <Canvas x:Name="PreviewCanvas" Width="300" Height="380">
                        <Border x:Name="PaperRect" Background="White" BorderBrush="#40000000" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" />
                            </Border.Effect>
                        </Border>
                        <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Canvas>
                </Border>
                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButtonStyle}" Click="OnPreviewPrevious" ToolTip="前のページ">
                        <ui:SymbolIcon Symbol="ChevronLeft24" />
                    </Button>
                    <TextBlock x:Name="PreviewText" MinWidth="120" Margin="8,0" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" />
                    <Button Style="{StaticResource ToolButtonStyle}" Click="OnPreviewNext" ToolTip="次のページ">
                        <ui:SymbolIcon Symbol="ChevronRight24" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="PaperText" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Grid>

        <DockPanel Margin="24,18,24,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="PrintButton" Width="110" Appearance="Primary" Content="印刷" IsDefault="True" Click="OnPrint" />
                <ui:Button x:Name="CancelButton" Width="110" Margin="8,0,0,0" Content="キャンセル" Click="OnCancel" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="Progress" Height="3" Margin="0,4,16,0" Visibility="Collapsed" Maximum="1" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ui:FluentWindow>
