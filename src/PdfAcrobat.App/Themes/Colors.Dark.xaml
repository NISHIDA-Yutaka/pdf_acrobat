<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App-specific surfaces (dark). Keys must match Colors.Light.xaml. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#161616" />
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ToolHoverBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ToolCheckedBackgroundBrush" Color="#263B57" />
    <SolidColorBrush x:Key="ToolCheckedForegroundBrush" Color="#7DB4FF" />
    <SolidColorBrush x:Key="FloatingBarBackgroundBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="FloatingBarBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="BrandBrush" Color="#F0443A" />
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#2680EB" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#378EF0" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#333840" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#5C3390FF" />
    <SolidColorBrush x:Key="SearchHitBrush" Color="#66FFD400" />
    <SolidColorBrush x:Key="CurrentSearchHitBrush" Color="#88FF7A00" />
    <SolidColorBrush x:Key="ThumbnailSelectedBorderBrush" Color="#4B9CF5" />
    <Color x:Key="PageShadowColor">#60000000</Color>
</ResourceDictionary>
