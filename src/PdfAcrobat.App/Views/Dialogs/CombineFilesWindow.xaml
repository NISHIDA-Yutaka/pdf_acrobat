<ui:FluentWindow x:Class="PdfAcrobat.App.Views.Dialogs.CombineFilesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ファイルを結合"
                 Width="760"
                 Height="600"
                 MinWidth="560"
                 MinHeight="420"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource AppBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="ファイルを結合" ShowMaximize="False" ShowMinimize="False" />

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Padding="12,6"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Click="OnAddFiles">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                            <TextBlock Margin="6,0,0,0" Text="ファイルを追加" />
                        </StackPanel>
                    </ui:Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="10,0" />
                    <Button x:Name="MoveUpButton" Style="{StaticResource ToolButtonStyle}" Click="OnMoveUp" ToolTip="上へ移動 (Alt+↑)">
                        <ui:SymbolIcon Symbol="ArrowUp24" />
                    </Button>
                    <Button x:Name="MoveDownButton" Style="{StaticResource ToolButtonStyle}" Click="OnMoveDown" ToolTip="下へ移動 (Alt+↓)">
                        <ui:SymbolIcon Symbol="ArrowDown24" />
                    </Button>
                    <Button x:Name="RemoveButton" Style="{StaticResource ToolButtonStyle}" Click="OnRemove" ToolTip="一覧から削除 (Delete)">
                        <ui:SymbolIcon Symbol="Delete24" />
                    </Button>
                    <Button x:Name="SortButton" Style="{StaticResource ToolButtonStyle}" Click="OnSortByName" ToolTip="ファイル名順に並べ替え">
                        <ui:SymbolIcon Symbol="TextSortAscending24" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SummaryText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}" />
                <Border />
            </DockPanel>
        </Border>

        <!-- File list -->
        <Grid Grid.Row="2" Margin="12,10,12,6">
            <ListBox x:Name="FileList"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     PreviewMouseLeftButtonDown="OnListMouseDown"
                     PreviewMouseMove="OnListMouseMove"
                     DragOver="OnListDragOver"
                     Drop="OnListDrop"
                     KeyDown="OnListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding Position}" />
                            <Border Grid.Column="1"
                                    Width="48"
                                    Height="62"
                                    Background="White"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="3"
                                           Margin="0,0,8,0"
                                           Symbol="ReOrderDotsVertical24"
                                           FontSize="18"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           ToolTip="ドラッグして順序を変更" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state / drop zone -->
            <Grid x:Name="EmptyState" IsHitTestVisible="False">
                <Rectangle RadiusX="12"
                           RadiusY="12"
                           Fill="{DynamicResource CardBackgroundBrush}"
                           Stroke="{DynamicResource DropZoneBorderBrush}"
                           StrokeThickness="1.5"
                           StrokeDashArray="5 4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Merge24" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Margin="0,10,0,4" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="結合するファイルを追加" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="PDF や画像をここにドラッグ＆ドロップするか、［ファイルを追加］から選択します。" />
                </StackPanel>
            </Grid>

            <!-- Busy -->
            <Border x:Name="BusyOverlay" Background="#80000000" CornerRadius="8" Visibility="Collapsed">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,18" CornerRadius="8" Background="{DynamicResource PanelBackgroundBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True" />
                        <TextBlock x:Name="BusyText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="16,10"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="CombineButton" Width="110" Appearance="Primary" Content="結合" IsDefault="True" Click="OnCombine" />
                    <ui:Button Width="110" Margin="8,0,0,0" Content="キャンセル" IsCancel="True" />
                </StackPanel>
                <CheckBox x:Name="BookmarksBox" VerticalAlignment="Center" Content="ファイルごとにしおりを追加" IsChecked="True" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
