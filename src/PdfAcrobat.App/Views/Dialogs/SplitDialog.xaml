<ui:FluentWindow x:Class="PdfAcrobat.App.Views.Dialogs.SplitDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="文書の分割"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <StackPanel>
        <ui:TitleBar Title="文書の分割" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="分割の方法" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <RadioButton x:Name="ByPagesRadio" GroupName="Mode" Content="ページ数" IsChecked="True" Checked="OnChanged" />
                <StackPanel Grid.Column="1" Margin="0,3" Orientation="Horizontal">
                    <TextBox x:Name="PagesBox" Width="72" Text="1" TextChanged="OnChanged" GotKeyboardFocus="OnBoxFocused" Tag="{Binding ElementName=ByPagesRadio}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="ページごとに 1 ファイル" />
                </StackPanel>

                <RadioButton x:Name="ByFilesRadio" Grid.Row="1" GroupName="Mode" Content="ファイル数" Checked="OnChanged" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3" Orientation="Horizontal">
                    <TextBox x:Name="FilesBox" Width="72" Text="2" TextChanged="OnChanged" GotKeyboardFocus="OnBoxFocused" Tag="{Binding ElementName=ByFilesRadio}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="個のファイルに均等に分割" />
                </StackPanel>

                <RadioButton x:Name="ByRangesRadio" Grid.Row="2" GroupName="Mode" Content="ページ範囲" Checked="OnChanged" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                    <TextBox x:Name="RangesBox" TextChanged="OnChanged" GotKeyboardFocus="OnBoxFocused" Tag="{Binding ElementName=ByRangesRadio}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="カンマで区切った範囲ごとに 1 ファイル（例: 1-3, 4-10, 11-）" />
                </StackPanel>

                <RadioButton x:Name="ByBookmarksRadio" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0" GroupName="Mode" Content="最上位のしおりごと" Checked="OnChanged" />
            </Grid>

            <TextBlock Margin="0,18,0,0" Style="{StaticResource PanelHeaderTextStyle}" Text="ファイル名" />
            <TextBox x:Name="NameBox" Margin="0,6,0,0" TextChanged="OnChanged" />
            <TextBlock Margin="0,14,0,0" Style="{StaticResource PanelHeaderTextStyle}" Text="保存先フォルダー" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" TextChanged="OnChanged" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="参照..." Click="OnBrowse" />
            </Grid>
            <TextBlock x:Name="Hint" Margin="0,12,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="OkButton" Width="96" Appearance="Primary" Content="分割" IsDefault="True" Click="OnOk" />
                <ui:Button Width="96" Margin="8,0,0,0" Content="キャンセル" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
