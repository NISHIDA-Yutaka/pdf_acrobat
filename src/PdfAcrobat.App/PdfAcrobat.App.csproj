<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PdfAcrobat</AssemblyName>
    <RootNamespace>PdfAcrobat.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfAcrobat.Core\PdfAcrobat.Core.csproj" />
    <ProjectReference Include="..\PdfAcrobat.Pdfium\PdfAcrobat.Pdfium.csproj" />
  </ItemGroup>

</Project>
