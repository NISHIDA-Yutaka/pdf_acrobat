<ui:FluentWindow x:Class="PdfAcrobat.App.Views.Dialogs.ExtractPagesDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ページの抽出"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <StackPanel>
        <ui:TitleBar Title="ページの抽出" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock Style="{StaticResource PanelHeaderTextStyle}" Text="抽出するページ" />
            <TextBox x:Name="RangeBox" Margin="0,6,0,0" TextChanged="OnRangeChanged" />
            <TextBlock x:Name="RangeHint" Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" />
            <CheckBox x:Name="DeleteBox" Margin="0,14,0,0" Content="抽出後にページを削除する" />
            <CheckBox x:Name="SeparateBox" Margin="0,6,0,0" Content="ページを個別のファイルとして抽出する" />
            <TextBlock Margin="28,2,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                       Text="オフの場合は、抽出したページを新しいタブで開きます。" />
            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="OkButton" Width="96" Appearance="Primary" Content="抽出" IsDefault="True" Click="OnOk" />
                <ui:Button Width="96" Margin="8,0,0,0" Content="キャンセル" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
